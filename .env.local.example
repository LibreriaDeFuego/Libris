# Copiar a .env.local (nunca commitear .env.local — ya está en .gitignore)
# y completar con los valores de Project Settings → API en supabase.com.
# Ambas son claves PÚBLICAS (protegidas por Row Level Security), seguras
# para exponer en el cliente — NUNCA pongas acá la service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
