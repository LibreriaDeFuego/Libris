# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android (TWA, migración 059) — bubblewrap regenera todo esto en CI a
# partir de android/twa-manifest.json; nada de esto se versiona, y la
# clave de firma NUNCA va al repo (vive como secret de GitHub Actions).
/android/app/
/android/gradle/
/android/gradlew
/android/gradlew.bat
/android/build.gradle
/android/settings.gradle
/android/*.keystore
/android/manifest-checksum.txt
/android/*.aab
/android/*.apk
